{
  "name": "@x-native/mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "X-Native MCP server — the design API over stdio for file-based agents (P1.10).",
  "bin": {
    "x-native-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/smoke.mjs tests/writes.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  }
}
